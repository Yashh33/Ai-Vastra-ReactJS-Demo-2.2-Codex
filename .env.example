# Every VITE_* variable the app reads (src/lib/env.ts). Names only — never commit real values.
# VITE_* values are baked in at build time: add new ones in Render before deploying.

# Required
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=

# Optional: demo login prefill
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
